# Database
MONGODB_URI=mongodb://localhost:27017/rekrut

# Database connection monitoring (optional)
DB_CONNECTION_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000
DB_MAX_POOL_SIZE=10

# Authentication
JWT_SECRET=your-super-secure-jwt-secret-should-be-at-least-32-chars
JWT_EXPIRES_IN=7d

# NextAuth.js
NEXTAUTH_SECRET=your-nextauth-secret-key-at-least-32-characters-long
NEXTAUTH_URL=http://localhost:3000

# Admin account (for seeding)
ADMIN_EMAIL=admin@rekrut.com
ADMIN_PASSWORD=SecurePassword123
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Email settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@rekrut.com

# AWS S3 settings
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-bucket-name

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
